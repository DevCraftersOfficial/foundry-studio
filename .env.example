# ==============================================================================
# Foundry Studio — Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - This file contains PLACEHOLDERS ONLY.
# - DO NOT include actual production credentials, secrets, or sensitive keys here.
# - Copy this file to `.env.local` for local development.
# ==============================================================================

# Server & Application Configuration
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
# For local Docker Compose setup:
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/foundry_studio

# Payload CMS Secrets
# Replace with a randomly generated 32+ character string in local development (.env.local)
PAYLOAD_SECRET=your-secure-payload-secret-at-least-32-characters-long

# Node Environment
NODE_ENV=development
