# Database connection string (PostgreSQL)
# Local development template: postgresql://foundry_app:your_password@localhost:5432/foundry_studio
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/foundry_studio
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foundry_studio

# Payload CMS secret key (at least 32 characters)
PAYLOAD_SECRET=your-secure-payload-secret-at-least-32-chars

# Canonical base URL for production SEO, OpenGraph, sitemap, and robots (required in production)
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

